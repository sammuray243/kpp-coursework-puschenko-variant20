<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
             http://xmlns.jcp.org/xml/ns/javaee
             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Transport Incidents V20</display-name>

    <description>
        Інформаційна система реєстрації
        інцидентів громадського транспорту.
        Курсова робота. Варіант 20.
    </description>

    <!-- ===================================== -->
    <!-- 1. SERVLET ДЛЯ МАРШРУТІВ              -->
    <!-- ===================================== -->

    <servlet>
        <servlet-name>RouteServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.servlet.RouteServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>RouteServlet</servlet-name>
        <url-pattern>/api/routes</url-pattern>
    </servlet-mapping>

    <!-- ===================================== -->
    <!-- 2. SERVLET ДЛЯ ТРАНСПОРТНИХ ЗАСОБІВ   -->
    <!-- ===================================== -->

    <servlet>
        <servlet-name>VehicleServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.servlet.VehicleServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>VehicleServlet</servlet-name>
        <url-pattern>/api/vehicles</url-pattern>
    </servlet-mapping>

    <!-- ===================================== -->
    <!-- 3. SERVLET ДЛЯ ІНЦИДЕНТІВ             -->
    <!-- ===================================== -->

    <servlet>
        <servlet-name>IncidentServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.servlet.IncidentServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>IncidentServlet</servlet-name>
        <url-pattern>/api/incidents</url-pattern>
    </servlet-mapping>

    <!-- ===================================== -->
    <!-- 4. SERVLET ДЛЯ ЗАВДАНЬ РЕАГУВАННЯ     -->
    <!-- ===================================== -->

    <servlet>
        <servlet-name>ResponseTaskServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.servlet.ResponseTaskServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>ResponseTaskServlet</servlet-name>
        <url-pattern>/api/tasks</url-pattern>
    </servlet-mapping>

    <!-- ===================================== -->
    <!-- НАЛАШТУВАННЯ СЕСІЇ                    -->
    <!-- ===================================== -->

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>
