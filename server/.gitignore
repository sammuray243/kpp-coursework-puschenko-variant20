
# ==========================================
# SERVER .gitignore
# Java / Maven / Tomcat 9 / MySQL
# ==========================================

# Maven output
target/
dependency-reduced-pom.xml

# Java compiled files
*.class
*.jar
*.war
*.ear

# IntelliJ IDEA
.idea/
*.iml
out/

# Tomcat runtime
logs/
work/
temp/
webapps/
conf/Catalina/
catalina.out

# Logs
*.log
hs_err_pid*
replay_pid*

# Local database credentials
db-local.properties
application-local.properties
.env
.env.*
!.env.example

# Temporary files
*.tmp
*.bak
*.swp
*~

# Test reports (generated by Maven)
surefire-reports/
failsafe-reports/

# Keep source and configuration
!src/
!pom.xml
